{
    "name": "construction-saas-backend",
    "version": "1.0.0",
    "description": "Multi-tenant Construction Management SaaS Backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "seed": "node seed.js",
        "db:migrate": "node scripts/migrate/run.js",
        "db:migrate:reset": "node scripts/migrate/run.js --reset",
        "db:migrate:dry": "node scripts/migrate/run.js --dry-run",
        "db:studio": "npx prisma studio",
        "validate:schema": "npx prisma validate"
    },
    "dependencies": {
        "@prisma/client": "^6.16.2",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.10.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "firebase-admin": "^10.3.0",
        "helmet": "^7.1.0",
        "imagekit": "^6.0.0",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "morgan": "^1.10.0",
        "multer": "^2.2.0",
        "multer-storage-cloudinary": "^2.2.1",
        "nodemailer": "^9.0.4",
        "pdfkit": "^0.17.2",
        "prisma": "^6.16.2",
        "socket.io": "^4.7.2",
        "stripe": "^14.10.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.2"
    }
}
