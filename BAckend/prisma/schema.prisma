// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & TENANCY ──────────────────────────────────────────────────────────

model Company {
  id                 String           @id @default(uuid())
  name               String           @unique
  email              String?
  phone              String?
  address            String?
  subscriptionPlanId String?
  subscriptionPlan   Plan?            @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionStatus String           @default("active")
  maxProjects        Int              @default(5)
  maxUsers           Int              @default(10)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  users              User[]
  projects           Project[]
  tasks              Task[]
  dailyLogs          DailyLog[]
  photos             Photo[]
  rfis               RFI[]
  tradeBids          TradeBid[]
  purchaseOrders     PurchaseOrder[]
  vendors            Vendor[]
  equipments         Equipment[]
  invoices           Invoice[]
  estimates          Estimate[]
  payrolls           Payroll[]
  timeLogs           TimeLog[]
  transactions       Transaction[]
  jobs               Job[]
  chatRooms          ChatRoom[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]
  schedules          Schedule[]
  taskTemplates      TaskTemplate[]

  @@map("companies")
}

model Plan {
  id          String    @id @default(uuid())
  name        String    @unique
  price       Float     @default(0)
  period      String    @default("month")
  maxProjects Int       @default(5)
  maxUsers    Int       @default(10)
  features    String[]  @default([])
  isPopular   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  companies   Company[]

  @@map("plans")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  name      String           @unique
  module    String
  action    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  roles     RolePermission[]
  users     UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  isAllowed    Boolean    @default(true)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String
  phoneNumber  String?
  avatar       String?
  status       String    @default("ACTIVE")
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  socketId     String?
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relationships
  fcmTokens            FcmToken[]
  userPermissions      UserPermission[]
  managedProjects      Project[]             @relation("ProjectPM")
  clientProjects       Project[]             @relation("ProjectClient")
  assignedTasks        Task[]                @relation("TaskAssigned")
  createdTasks         Task[]                @relation("TaskCreated")
  subTasks             SubTask[]
  projectDocuments     ProjectDocument[]
  projectNotes         ProjectNote[]
  projectUpdates       ProjectUpdate[]
  dailyLogs            DailyLog[]
  uploadedPhotos       Photo[]
  uploadedDrawings     Drawing[]
  drawingAnnotations   DrawingAnnotation[]
  createdRFIs          RFI[]                 @relation("RFICreated")
  assignedRFIs         RFI[]                 @relation("RFIAssigned")
  reportedIssues       Issue[]               @relation("IssueReported")
  assignedIssues       Issue[]               @relation("IssueAssigned")
  correctionRequests   CorrectionRequest[]
  tradeBids            TradeBid[]
  approvedPOs          PurchaseOrder[]
  invoices             Invoice[]
  payrolls             Payroll[]
  timeLogs             TimeLog[]
  jobWorkers           JobWorker[]
  jobNotes             JobNote[]
  jobTimeLogs          JobTimeLog[]
  jobActivities        JobActivityLog[]
  chatParticipants     ChatParticipant[]
  sentMessages         Chat[]
  notifications        Notification[]
  supportTickets       SupportTicket[]
  auditLogs            AuditLog[]
  todos                Todo[]

  @@map("users")
}

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  device    String?
  createdAt DateTime @default(now())

  @@map("fcm_tokens")
}

// ─── PROJECT MANAGEMENT ──────────────────────────────────────────────────────

model Project {
  id             String    @id @default(uuid())
  name           String
  code           String?
  description    String?
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  pmId           String?
  projectManager User?     @relation("ProjectPM", fields: [pmId], references: [id])
  clientId       String?
  client         User?     @relation("ProjectClient", fields: [clientId], references: [id])
  status         String    @default("ACTIVE")
  startDate      DateTime?
  endDate        DateTime?
  budget         Float     @default(0)
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tasks              Task[]
  schedules          Schedule[]
  documents          ProjectDocument[]
  notes              ProjectNote[]
  updates            ProjectUpdate[]
  dailyLogs          DailyLog[]
  photos             Photo[]
  drawings           Drawing[]
  rfis               RFI[]
  issues             Issue[]
  correctionRequests CorrectionRequest[]
  tradeBids          TradeBid[]
  purchaseOrders     PurchaseOrder[]
  equipments         Equipment[]
  invoices           Invoice[]
  estimates          Estimate[]
  timeLogs           TimeLog[]
  jobs               Job[]
  chatRooms          ChatRoom[]

  @@map("projects")
}

model Task {
  id             String    @id @default(uuid())
  title          String
  description    String?
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  assignedToId   String?
  assignedToUser User?     @relation("TaskAssigned", fields: [assignedToId], references: [id])
  createdById    String?
  createdByUser User?     @relation("TaskCreated", fields: [createdById], references: [id])
  status         String    @default("PENDING")
  priority       String    @default("MEDIUM")
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float     @default(0)
  actualHours    Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  subTasks       SubTask[]

  @@map("tasks")
}

model SubTask {
  id           String    @id @default(uuid())
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  title        String
  completed    Boolean   @default(false)
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("sub_tasks")
}

model TaskTemplate {
  id        String   @id @default(uuid())
  name      String
  category  String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  tasks     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("task_templates")
}

model Schedule {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  title     String
  startDate DateTime
  endDate   DateTime
  status    String    @default("PLANNED")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("schedules")
}

model ProjectDocument {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  name         String
  fileUrl      String
  fileType     String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@map("project_documents")
}

model ProjectNote {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@map("project_notes")
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  summary   String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@map("project_updates")
}

// ─── FIELD OPERATIONS ────────────────────────────────────────────────────────

model DailyLog {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  engineerId  String
  engineer    User     @relation(fields: [engineerId], references: [id])
  logDate     DateTime @default(now())
  weather     String?
  notes       String?
  workerCount Int      @default(0)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("daily_logs")
}

model Photo {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  url          String
  caption      String?
  category     String?
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@map("photos")
}

model Drawing {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  title        String
  fileUrl      String
  version      String   @default("v1.0")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  annotations  DrawingAnnotation[]

  @@map("drawings")
}

model DrawingAnnotation {
  id        String   @id @default(uuid())
  drawingId String
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  type      String
  coords    Json
  text      String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@map("drawing_annotations")
}

model RFI {
  id           String    @id @default(uuid())
  number       Int
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  createdById  String
  createdBy    User      @relation("RFICreated", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("RFIAssigned", fields: [assignedToId], references: [id])
  title        String
  question     String
  answer       String?
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("rfis")
}

model Issue {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedById String
  reportedBy   User     @relation("IssueReported", fields: [reportedById], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("IssueAssigned", fields: [assignedToId], references: [id])
  title        String
  description  String?
  severity     String   @default("MEDIUM")
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("issues")
}

model CorrectionRequest {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  itemType      String
  description   String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@map("correction_requests")
}

// ─── PROCUREMENT & ASSETS ────────────────────────────────────────────────────

model TradeBid {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  subcontractorId String
  subcontractor   User     @relation(fields: [subcontractorId], references: [id])
  trade           String
  bidAmount       Float
  status          String   @default("SUBMITTED")
  proposalUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("trade_bids")
}

model Vendor {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  contactPerson String?
  email         String?
  phone         String?
  trade         String?
  taxId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNumber     Int
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  approvedById String?
  approvedBy   User?     @relation(fields: [approvedById], references: [id])
  items        Json      @default("[]")
  totalAmount  Float     @default(0)
  status       String    @default("DRAFT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("purchase_orders")
}

model Equipment {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  name         String
  serialNumber String?
  category     String?
  status       String   @default("AVAILABLE")
  dailyRate    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("equipments")
}

// ─── FINANCE & TIME TRACKING ─────────────────────────────────────────────────

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  clientId      String?
  client        User?    @relation(fields: [clientId], references: [id])
  amount        Float    @default(0)
  dueDate       DateTime
  status        String   @default("PENDING")
  items         Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@map("invoices")
}

model Estimate {
  id             String   @id @default(uuid())
  estimateNumber String   @unique
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  amount         Float    @default(0)
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@map("estimates")
}

model Payroll {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  workerId    String
  worker      User     @relation(fields: [workerId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  totalHours  Float    @default(0)
  amountPaid  Float    @default(0)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("payrolls")
}

model TimeLog {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  clockIn       DateTime
  clockOut      DateTime?
  durationHours Float     @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("time_logs")
}

model Transaction {
  id                    String   @id @default(uuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  amount                Float
  type                  String
  paymentMethod         String?
  stripePaymentIntentId String?
  status                String   @default("COMPLETED")
  createdAt             DateTime @default(now())
  deletedAt             DateTime?

  @@map("transactions")
}

// ─── JOBS & WORK ORDERS ──────────────────────────────────────────────────────

model Job {
  id         String   @id @default(uuid())
  title      String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  clientName String?
  status     String   @default("IN_PROGRESS")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  jobTasks      JobTask[]
  jobWorkers    JobWorker[]
  jobNotes      JobNote[]
  jobTimeLogs   JobTimeLog[]
  jobActivities JobActivityLog[]

  @@map("jobs")
}

model JobTask {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  status       String   @default("PENDING")
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("job_tasks")
}

model JobWorker {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  role      String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@map("job_workers")
}

model JobNote {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@map("job_notes")
}

model JobTimeLog {
  id        String    @id @default(uuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User      @relation(fields: [workerId], references: [id])
  clockIn   DateTime
  clockOut  DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("job_time_logs")
}

model JobActivityLog {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  action        String
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  @@map("job_activity_logs")
}

// ─── CHAT & NOTIFICATIONS ────────────────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(uuid())
  roomType  String   @default("DIRECT")
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  participants ChatParticipant[]
  messages     Chat[]

  @@map("chat_rooms")
}

model ChatParticipant {
  id        String   @id @default(uuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  @@unique([roomId, userId])
  @@map("chat_participants")
}

model Chat {
  id          String   @id @default(uuid())
  roomId      String
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  message     String
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@map("chats")
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   @default("INFO")
  readStatus  Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@map("notifications")
}

model SupportTicket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  subject      String
  description  String
  priority     String   @default("MEDIUM")
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("support_tickets")
}

// ─── AUDIT, COUNTERS & TODOS ─────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Counter {
  id        String   @id @default(uuid())
  modelName String   @unique
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("counters")
}

model Todo {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("todos")
}

model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  status    String   @default("PROCESSING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("processed_webhook_events")
}

model SubscriptionOrder {
  id          String   @id @default(uuid())
  orderId     String   @unique
  companyId   String
  planId      String
  userId      String
  amountPaise Int
  currency    String   @default("INR")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subscription_orders")
}
